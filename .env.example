# ==============================================================================
# Application Configuration
# ==============================================================================
APP_NAME="Production RAG Engine"
APP_ENV=development
LOG_LEVEL=INFO

# ==============================================================================
# LLM Provider Configuration
# Supported providers: "groq" (default), "gemini"
# ==============================================================================
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048

# API Keys (Free Tier)
# Get Groq key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: Get Gemini key: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Embedding & Vector Database (100% Free & Local)
# ==============================================================================
# Local HuggingFace / FastEmbed model running on CPU
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# ChromaDB Local Persistence
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# ==============================================================================
# Document Processing & Chunking
# ==============================================================================
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ==============================================================================
# Retrieval & Reranker Settings
# ==============================================================================
TOP_K_RETRIEVAL=10     # Jumlah dokumen awal dari Hybrid Search (Vector + BM25)
TOP_K_RERANK=3         # Dokumen terbaik setelah di-rerank FlashRank (Cross-Encoder)
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
